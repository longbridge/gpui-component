{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpui.rs/registry-item.schema.json",
  "title": "GPUI Component Registry Item",
  "type": "object",
  "required": ["name", "type", "dependencies", "registryDependencies", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": { "enum": ["registry:ui", "registry:block", "registry:theme", "registry:lib"] },
    "description": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "registryDependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type", "target"],
        "properties": {
          "path": { "type": "string" },
          "type": { "enum": ["registry:ui", "registry:block", "registry:theme", "registry:lib"] },
          "target": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
