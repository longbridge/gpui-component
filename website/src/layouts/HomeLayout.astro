---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'zh-CN';
}

const { title, description, lang = 'en' } = Astro.props;
---

<BaseLayout title={title} description={description} lang={lang}>
  <slot />
</BaseLayout>

<style is:global>
  @import '../styles/global.css';
</style>
