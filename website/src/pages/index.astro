---
import HomeLayout from '../layouts/HomeLayout.astro';
import { fetchStarCount } from '../lib/github';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
---

<HomeLayout
  lang="en"
  title="GPUI Component"
  description="A comprehensive Rust framework for building fantastic, high-performance desktop apps with GPUI."
>
  <!-- The home page is a standalone Vue island that contains all its own styling -->
  <div id="home-root" data-star-count={starCount} data-base={base} data-lang="en"></div>
</HomeLayout>

<script>
  // Mount the Vue home page app
  import { createApp } from 'vue';
  import HomeApp from '../components/HomeApp.vue';

  const root = document.getElementById('home-root');
  if (root) {
    const starCount = parseInt(root.dataset.starCount ?? '0', 10);
    const base = root.dataset.base ?? '/gpui-component/';
    const lang = root.dataset.lang ?? 'en';
    createApp(HomeApp, { starCount, base, lang }).mount(root);
  }
</script>
