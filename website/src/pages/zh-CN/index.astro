---
import HomeLayout from '../../layouts/HomeLayout.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { fetchStarCount } from '../../lib/github';

let starCount = 0;
try { starCount = await fetchStarCount(); } catch {}

const base = import.meta.env.BASE_URL;
---

<HomeLayout
  lang="zh-CN"
  title="GPUI Kit"
  description="为 Rust 桌面应用提供完整 UI 系统、数据表格、Dock 布局、图表与代码编辑器。"
>
  <Nav lang="zh-CN" currentPath={Astro.url.pathname} starCount={starCount} />

  <!-- The bands below are a Vue island; the bar and footer around them are
       the same components every content page uses. -->
  <div id="home-root-zh" data-star-count={starCount} data-base={base} data-lang="zh-CN"></div>

  <SiteFooter lang="zh-CN" />
</HomeLayout>

<script>
  import { createApp } from 'vue';
  import HomeApp from '../../components/HomeApp.vue';

  const root = document.getElementById('home-root-zh');
  if (root) {
    const starCount = parseInt(root.dataset.starCount ?? '0', 10);
    const base = root.dataset.base ?? import.meta.env.BASE_URL;
    const lang = root.dataset.lang ?? 'zh-CN';
    createApp(HomeApp, { starCount, base, lang }).mount(root);
  }
</script>
